---
# Copie para vault.yml, preencha e criptografe:
#   cp vault.yml.example vault.yml
#   ansible-vault encrypt inventories/producao/group_vars/all/vault.yml
#
# Credenciais de acesso SSH aos equipamentos (Cisco / Huawei)
vault_net_user: "svc_ansible"
vault_net_password: "TROCAR"
vault_enable_password: "TROCAR"        # IOS enable (se o usuário não entrar em priv 15)

# Chave compartilhada TACACS+ (mesma configurada no ISE)
vault_tacacs_key: "TROCAR"

# Token da API REST do FortiGate (System > Administrators > REST API Admin)
vault_fortios_access_token: "TROCAR"
